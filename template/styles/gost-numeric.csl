<?xml version="1.0" encoding="UTF-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="ru-RU">
  <info>
    <title>МТУСИ — числовые ссылки по ГОСТ Р 7.0.5–2008</title>
    <id>https://example.org/styles/mtuci-report-references</id>
    <updated>2026-11-22T00:00:00+00:00</updated>
  </info>
  <!-- bibliography-locales.typ replaces these markers inside each rendered entry. -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with=".&#160;" delimiter=", "/>
    </names>
  </macro>
  <macro name="editor">
    <choose>
      <if variable="editor">
        <group delimiter=" ">
          <text value="⟦mtuci:editor⟧"/>
          <names variable="editor"><name initialize-with=".&#160;" delimiter=", "/></names>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="translator">
    <choose>
      <if variable="translator">
        <group delimiter=" ">
          <text value="⟦mtuci:translator⟧"/>
          <names variable="translator"><name initialize-with=".&#160;" delimiter=", "/></names>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition"><text variable="edition" suffix="⟦mtuci:edition⟧"/></if>
      <else><text variable="edition"/></else>
    </choose>
  </macro>
  <macro name="publication">
    <group delimiter=", ">
      <group delimiter="&#160;: ">
        <text variable="publisher-place"/>
        <text variable="publisher"/>
      </group>
      <date variable="issued"><date-part name="year"/></date>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="URL:&#160;"/>
          <date variable="accessed" prefix="(⟦mtuci:accessed⟧:&#160;" suffix=")">
            <date-part name="day" form="numeric-leading-zeros" suffix="."/>
            <date-part name="month" form="numeric-leading-zeros" suffix="."/>
            <date-part name="year"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography>
    <layout suffix=".">
      <text variable="language" prefix="⟦mtuci:lang:" suffix="⟧"/>
      <text variable="citation-number" suffix=".&#160;"/>
      <group delimiter=". – ">
        <group delimiter=" ">
          <text macro="author"/>
          <choose>
            <if type="patent">
              <group delimiter="&#160;: ">
                <text variable="title"/>
                <text variable="number" prefix="⟦mtuci:patent⟧&#160;"/>
              </group>
            </if>
            <else>
              <group delimiter=" ">
                <group delimiter="&#160;: ">
                  <text variable="title"/>
                  <group delimiter=" ">
                    <text variable="genre"/>
                    <text variable="number"/>
                  </group>
                </group>
                <group prefix="/ " delimiter=" ; ">
                  <text macro="editor"/>
                  <text macro="translator"/>
                </group>
                <text variable="container-title" prefix="// "/>
              </group>
            </else>
          </choose>
        </group>
        <choose>
          <if type="patent"><text variable="note"/></if>
          <else>
            <text macro="edition"/>
            <text macro="publication"/>
            <group delimiter=", ">
              <text variable="volume" prefix="⟦mtuci:volume⟧&#160;"/>
              <text variable="issue" prefix="⟦mtuci:issue⟧&#160;"/>
            </group>
            <text variable="page" prefix="⟦mtuci:page⟧&#160;"/>
            <text variable="number-of-pages" suffix="&#160;⟦mtuci:page-total⟧"/>
          </else>
        </choose>
        <text macro="access"/>
        <text variable="DOI" prefix="DOI&#160;"/>
      </group>
    </layout>
  </bibliography>
</style>
